def transform_string(input_string, replace_char='*'):
    words = input_string.split()
    

    for i in range(len(words)):
        if i % 2 == 1:  
            words[i] = words[i][::-1]
        if i % 2 == 0: 
            words[i] = ''.join([replace_char if char.lower() in 'aeiou' else char for char in words[i]])
    
   
    return ' '.join(words)


input_string = "Git to win github challenge"
output_string = transform_string(input_string)
print(output_string)



